<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Amount + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvCardAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="₱0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1E40AF" />

        <TextView
            android:id="@+id/tvCardStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F59E0B" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="10dp" />

    <!-- Tenant name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tenant  "
            android:textSize="13sp"
            android:textColor="#64748B" />
        <TextView
            android:id="@+id/tvCardTenantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:textColor="#334155" />
    </LinearLayout>

    <!-- Due date -->
    <TextView
        android:id="@+id/tvCardDueDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Due: —"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:layout_marginBottom="4dp" />

    <!-- Paid date -->
    <TextView
        android:id="@+id/tvPaidDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paid on: —"
        android:textSize="13sp"
        android:textColor="#10B981"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvCardDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="8dp" />

    <!-- Mark as Paid / Confirm Cash (landlord) -->
    <Button
        android:id="@+id/btnMarkPaid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mark as Paid"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#10B981"
        android:visibility="gone" />

    <!-- Pay Now (tenant) -->
    <Button
        android:id="@+id/btnPayNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pay Now"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1E40AF"
        android:visibility="gone" />

</LinearLayout>
